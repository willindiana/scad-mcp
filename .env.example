# Application reads exported environment, not this file automatically.
SCAD_MCP_TRANSPORT=http
SCAD_RENDERER=local
SCAD_ARTIFACTS_DIR=/artifacts
SCAD_MCP_HOST=0.0.0.0
SCAD_MCP_PORT=8781
SCAD_MCP_API_KEY_FILE=/run/secrets/scad-mcp-api-key
# Optional second key; omit unless file exists and is safe.
# SCAD_MCP_GATEWAY_KEY_FILE=/run/secrets/scad-mcp-gateway-key
# SCAD_PRESETS_FILE=/config/presets.json
# Host development only:
# SCAD_DOCKER_IMAGE=scad-proof
